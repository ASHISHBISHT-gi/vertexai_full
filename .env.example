# Used by `docker compose --profile app up`. Copy to .env (never commit it).
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
POSTGRES_PASSWORD=change-me
APP_URL=http://localhost:8080

# Optional: real email and real AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Vertexon Learning <no-reply@example.com>
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
