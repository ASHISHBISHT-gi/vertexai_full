# Copy to .env. Never commit .env.

# Same database as the Node backend, and the SAME secret (so this service accepts the same login tokens).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
JWT_ACCESS_SECRET=paste-the-same-value-as-backend/.env

CORS_ORIGIN=http://localhost:5173

# ---- Which AI to use -------------------------------------------------------------------------
# "fake" = DEMO MODE. No keys, no network, no cost. It answers by picking sentences out of the transcript,
# so you can build and test the whole pipeline. Switch to the real thing when you have keys.
LLM_PROVIDER=fake              # fake | anthropic
EMBEDDING_PROVIDER=fake        # fake | voyage | openai

# ---- Real Claude (LLM_PROVIDER=anthropic) ----------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_CHAT_MODEL=claude-haiku-5-5        # fast and cheap: the tutor chat
# LLM_GENERATE_MODEL=claude-sonnet-5-5   # better quality: quizzes, flashcards, study plans

# ---- Real embeddings (Anthropic has no embeddings model; Voyage AI is what their docs recommend) ----
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_API_KEY=pa-...
# EMBEDDING_MODEL=voyage-4
#
# or OpenAI (also works for other OpenAI-compatible servers via EMBEDDING_BASE_URL):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
