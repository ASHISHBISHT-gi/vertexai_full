# Copy to .env (never commit .env). Every value below has a safe default except DATABASE_URL and JWT_ACCESS_SECRET.
PORT=4000
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Behind NGINX / a load balancer set this to 1 so rate limits see the real visitor IP.
TRUST_PROXY=0

# Rate limits (PRD 8.9). Turn off only for load tests / the smoke test.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=100
RATE_LIMIT_POST_PER_MIN=10

# Cache lifetimes in seconds (PRD 9.4).
CATALOG_CACHE_SECONDS=300
LEADERBOARD_CACHE_SECONDS=60

# Email. Leave SMTP_HOST empty in development: emails are printed to the log instead of sent.
# Free options for a demo: Brevo, Resend (SMTP), Gmail app password, or Mailtrap sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Vertexon Learning <no-reply@example.com>
EMAIL_WORKER_ENABLED=true
